Bold"},"size":20.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":104,"id":124},{"k":"text","x":469.0,"y":2677.17,"w":12.0,"h":20.0,"text":"1","lh":null,"nlines":1,"rot":false,"runs":[{"text":"1","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#B9B9B9","opacity":1.0,"ls":null}],"seq":108,"id":125},{"k":"text","x":501.0,"y":2677.17,"w":206.82,"h":20.0,"text":"Reunir documentación","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Reunir documentación","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":0.0}],"seq":110,"id":126},{"k":"text","x":1183.0,"y":2677.17,"w":12.0,"h":20.0,"text":"1","lh":null,"nlines":1,"rot":false,"runs":[{"text":"1","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":null}],"seq":115,"id":127},{"k":"text","x":1215.0,"y":2677.17,"w":206.82,"h":20.0,"text":"Reunir documentación","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Reunir documentación","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":117,"id":128},{"k":"text","x":388.0,"y":2946.59,"w":1072.39,"h":37.0,"text":"Ten en cuenta las siguientes recomendaciones para mejorar la experiencia de los usuarios cuando utilicen el módulo de inicio de sesión en tu \npágina web.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Ten en cuenta las siguientes recomendaciones para mejorar la experiencia de los usuarios cuando utilicen el módulo de inicio de sesión en tu página web.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":119,"id":129},{"k":"text","x":388.0,"y":3095.59,"w":530.05,"h":15.0,"text":"- Los títulos de las cajas de texto deben ser claros, concisos y cortos. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Los títulos de las cajas de texto deben ser claros, concisos y cortos. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":121,"id":130},{"k":"text","x":388.0,"y":3139.59,"w":1104.87,"h":37.0,"text":"- Utiliza un sistema jerárquico en la estructura del acordeón, dando relevancia por medio del tamaño y color a los títulos que acompañen el texto \ndescriptivo.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- Utiliza un sistema jerárquico en la estructura del acordeón, dando relevancia por medio del tamaño y color a los títulos que acompañen el texto descriptivo.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":123,"id":131},{"k":"text","x":388.0,"y":3039.17,"w":264.34,"h":20.0,"text":"Contenidos claros y concisos","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Contenidos claros y concisos","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":125,"id":132},{"k":"text","x":429.0,"y":2886.2,"w":187.75,"h":24.0,"text":"Buenas prácticas","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Buenas prácticas","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":126,"id":133},{"k":"text","x":388.0,"y":3323.59,"w":1058.82,"h":37.0,"text":"Procura cumplir con los requerimientos y criterios de accesibilidad actuales. Así las personas con discapacidad podrán percibir, comprender, \nnavegar e interactuar con éxito en tu sitio web. Específicamente, atiende estas recomendaciones para el componente “Acordeón”: ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Procura cumplir con los requerimientos y criterios de accesibilidad actuales. Así las personas con discapacidad podrán percibir, comprender, navegar e interactuar con éxito en tu sitio web. Específicamente, atiende estas recomendaciones para el componente “Acordeón”: ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":128,"id":134},{"k":"text","x":388.0,"y":3389.59,"w":883.43,"h":15.0,"text":"- Ten en cuenta que el foco debe ser fácilmente perceptible para el usuario, con un contraste mínimo de 4,5:1 ratio. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Ten en cuenta que el foco debe ser fácilmente perceptible para el usuario, con un contraste mínimo de 4,5:1 ratio. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":131,"id":135},{"k":"text","x":388.0,"y":3433.59,"w":1088.0,"h":37.0,"text":"- Durante la navegación por teclado, el acordeón no debe abrirse automáticamente. Será el usuario quien decida abrir el contenido con la tecla \nenter o con la barra espaciadora. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- Durante la navegación por teclado, el acordeón no debe abrirse automáticamente. Será el usuario quien decida abrir el contenido con la tecla enter o con la barra espaciadora. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":133,"id":136},{"k":"text","x":388.0,"y":3499.59,"w":787.09,"h":15.0,"text":"- Haz uso de la jerarquía de encabezados, tanto en el título del acordeón como el contenido del mismo. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Haz uso de la jerarquía de encabezados, tanto en el título del acordeón como el contenido del mismo. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":136,"id":137},{"k":"text","x":388.0,"y":3543.59,"w":1104.55,"h":37.0,"text":"- Es necesario implementar el atributo aria-expanded o el que corresponda, según la documentación de la tecnología que se esté utilizando, para \nque los lectores de pantalla indiquen al usuario si el acordeón está abierto o cerrado. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- Es necesario implementar el atributo aria-expanded o el que corresponda, según la documentación de la tecnología que se esté utilizando, para que los lectores de pantalla indiquen al usuario si el acordeón está abierto o cerrado. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":138,"id":138},{"k":"text","x":388.0,"y":3609.59,"w":636.12,"h":15.0,"text":"- Recuerda que el acordeón debe ser responsive y funcional en dispositivos móviles.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Recuerda que el acordeón debe ser responsive y funcional en dispositivos móviles.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":141,"id":139},{"k":"text","x":429.0,"y":3263.2,"w":146.23,"h":24.0,"text":"Accesibilidad","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Accesibilidad","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":142,"id":140},{"k":"text","x":247.0,"y":81.94,"w":301.97,"h":24.0,"text":"Componentes generales","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Componentes generales","font":{"family":"Montserrat","weight":600,"style":"normal","ps":"Montserrat-SemiBold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":145,"id":141},{"k":"text","x":249.0,"y":111.29,"w":77.86,"h":16.0,"text":"Acordeón","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Acordeón","font":{"family":"Montserrat","weight":400,"style":"normal","ps":"Montserrat-Regular"},"size":16.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":146,"id":142},{"k":"text","x":1684.24,"y":80.88,"w":161.52,"h":14.0,"text":"S