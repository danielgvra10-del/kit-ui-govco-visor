y":1.0,"ls":0.0}],"seq":19,"id":92},{"k":"text","x":126.0,"y":398.17,"w":154.04,"h":20.0,"text":"Buenas prácticas","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Buenas prácticas","font":{"family":"Nunito Sans","weight":600,"style":"normal","ps":"NunitoSans-SemiBold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":0.0}],"seq":26,"id":93},{"k":"text","x":388.0,"y":3834.59,"w":1108.93,"h":37.0,"text":" - El carrusel debe ser navegable por teclado y permitir al usuario la interacción con los controles: adelante/atrás, reproducir/pausar, así como los \nindicadores de posición.   ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":" - El carrusel debe ser navegable por teclado y permitir al usuario la interacción con los controles: adelante/atrás, reproducir/pausar, así como los indicadores de posición.   ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":29,"id":94},{"k":"text","x":388.0,"y":3900.59,"w":1129.82,"h":37.0,"text":"- El componente debe tener un contraste de 4,5:1 (ratio mínimo) entre el contenido del carrusel y los controles, para garantizar que sean percibidos \nvisualmente.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- El componente debe tener un contraste de 4,5:1 (ratio mínimo) entre el contenido del carrusel y los controles, para garantizar que sean percibidos visualmente.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":32,"id":95},{"k":"text","x":388.0,"y":3796.59,"w":739.34,"h":15.0,"text":"Para garantizar contenidos accesibles se sugiere tener en cuenta las siguientes recomendaciones:","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Para garantizar contenidos accesibles se sugiere tener en cuenta las siguientes recomendaciones:","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":34,"id":96},{"k":"text","x":429.0,"y":3736.2,"w":146.23,"h":24.0,"text":"Accesibilidad","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Accesibilidad","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":35,"id":97},{"k":"text","x":388.0,"y":3524.59,"w":1146.45,"h":37.0,"text":"- Haz uso de imágenes con buen contraste para permitir la correcta visualización de los elementos de navegación del carrusel o, en su defecto, incluye \nen el diseño capas de transparencia que resalten los elementos de navegación.  ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- Haz uso de imágenes con buen contraste para permitir la correcta visualización de los elementos de navegación del carrusel o, en su defecto, incluye en el diseño capas de transparencia que resalten los elementos de navegación.  ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":37,"id":98},{"k":"text","x":388.0,"y":3590.59,"w":895.67,"h":15.0,"text":"- Recuerda que los indicadores de posición, controles de reproducción y flechas de navegación son de uso obligatorio. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Recuerda que los indicadores de posición, controles de reproducción y flechas de navegación son de uso obligatorio. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":40,"id":99},{"k":"text","x":388.0,"y":3634.59,"w":935.28,"h":15.0,"text":"- Implementa un efecto active al seleccionar los elementos de navegación con el fin de darles mayor contraste y visibilidad.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Implementa un efecto active al seleccionar los elementos de navegación con el fin de darles mayor contraste y visibilidad.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opaci