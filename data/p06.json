ight":800,"style":"normal","ps":"NunitoSans-ExtraBold"},"size":22.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":200,"id":158},{"k":"text","x":388.0,"y":2083.59,"w":1105.94,"h":59.0,"text":"- Ten en cuenta que por usabilidad es recomendable que la ‘Barra de accesibilidad’ no aparezca desde el breakpoint de tablets (ancho de pantalla \nde 768 a hasta 992px.) porque a partir de allí puede llegar a ocultar contenido. (Los dispositivos móviles cuentan con opciones de accesibilidad \nnativas). ","lh":22.0,"nlines":3,"rot":false,"runs":[{"text":"- Ten en cuenta que por usabilidad es recomendable que la ‘Barra de accesibilidad’ no aparezca desde el breakpoint de tablets (ancho de pantalla de 768 a hasta 992px.) porque a partir de allí puede llegar a ocultar contenido. (Los dispositivos móviles cuentan con opciones de accesibilidad nativas). ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":201,"id":159},{"k":"text","x":388.0,"y":2171.59,"w":1011.52,"h":15.0,"text":"- Respeta medidas, proporciones y grosores adecuados para los íconos, de modo que los usuarios puedan identificarlos con facilidad. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Respeta medidas, proporciones y grosores adecuados para los íconos, de modo que los usuarios puedan identificarlos con facilidad. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":205,"id":160},{"k":"text","x":388.0,"y":2215.59,"w":1073.32,"h":37.0,"text":"- Utiliza tamaños de letra apropiados para los textos y presenta la información de manera clara y precisa. Así, los contenidos serán legibles y \ncomprensibles para los lectores.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- Utiliza tamaños de letra apropiados para los textos y presenta la información de manera clara y precisa. Así, los contenidos serán legibles y comprensibles para los lectores.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":207,"id":161},{"k":"text","x":388.0,"y":2024.68,"w":212.81,"h":22.0,"text":"Tamaños pertinentes","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Tamaños pertinentes","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":22.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":209,"id":162},{"k":"text","x":388.0,"y":2367.59,"w":1040.1,"h":15.0,"text":"- Sigue las recomendaciones de accesibilidad a la hora de indicar a los usuarios el lugar donde se encuentra el componente y describirlo. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Sigue las recomendaciones de accesibilidad a la hora de indicar a los usuarios el lugar donde se encuentra el componente y describirlo. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":210,"id":163},{"k":"text","x":388.0,"y":2411.59,"w":792.85,"h":15.0,"text":"- Ubica el componente en un lugar visible y de fácil acceso; preferiblemente, en el centro y a la derecha.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Ubica el componente en un lugar visible y de fácil acceso; preferiblemente, en el centro y a la derecha.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":212,"id":164},{"k":"text","x":388.0,"y":2308.68,"w":208.38,"h":22.0,"text":"Aplicación adecuada","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Aplicación adecuada","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":22.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":213,"id":165},{"k":"text","x":388.0,"y":1953.59,"w":638.78,"h":15.0,"text":"Atiende las siguientes recomendaciones para mejorar la experiencia de los usuarios:","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Atiende las siguientes recomendaciones para mejorar la experiencia de los usuarios:","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":214,"id":166},{"k":"text","x":388.0,"y":2703.59,"w":685.78,"h":81.0,"text":"La barra de accesibilidad debe incluir las siguientes funciones básicas: \n           - Aumentar el tamaño de la fuente para mejorar la legibilidad del contenido.  \n           - Disminuir el tamaño de la fuente para permitir una visualización más compacta.  \n           - Cambiar el color de contraste para mejorar la legibilidad y la accesibilidad. ","lh":22.0,"nlines":4,"rot":false,"runs":[{"text":"La barra de accesibilidad debe incluir las siguientes funciones básicas:            - Aumentar el tamaño de la fuente para mejorar la legibilidad del contenido.             - Disminuir el tamaño de la fuente para permitir una visualización más compacta.             - Cambiar el color de contraste para mejorar la legibilidad y la accesibilidad. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":215,"id":167},{"k":"text","x":388.0,"y":2813.59,"w":1106.32,"h":37.0,"text":"La barra de accesibilidad debe estar presente de manera consistente en todas las páginas del sitio web. Esto garantizará que los usuarios puedan \nacceder fácilmente a las funciones de accesibilidad sin importar en qué página se encuentren. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"La barra de accesibilidad debe estar presente de manera consistente en todas las páginas del sitio web. Esto garantizará que los usuarios puedan acceder fácilmente a las funciones de accesibilidad sin importar en qué página se encuentren. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":220,"id":168},{"k":"text","x":388.0,"y":2644.68,"w":248.53,"h":22.0,"text":"Funcionalidad y posición","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Funcionalidad y posición","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":22.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":222,"id":169},{"k":"text","x":388.0,"y":2965.59,"w":1109.11,"h":37.0,"text":"- La barra de accesibilidad debe ser navegable y operable por teclado, se recomienda que su acceso por teclado sea después de la navegación del \nmenú principal. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- La barra de accesibilidad debe ser navegable y operable por teclado, se recomienda que su acceso por teclado sea después de la navegación del menú principal. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":223,"id":170},{"k":"text","x":388.0,"y":3031.59,"w":1117.16,"h":15.0,"text":"- Al utilizar el teclado para navegar y seleccionar elementos en la barra de accesibilidad, se debe proporcionar un enfoque visual destacado (focus).","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Al utilizar el teclado para navegar y seleccionar elementos en la barra de accesibilidad, se debe proporcionar un enfoque visual destacado (focus).","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":226,"id":171},{"k":"text","x":388.0,"y":2906.68,"w":342.34,"h":22.0,"text":"Enfoque y navegación por teclado","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Enfoque y navegación por teclado","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":22.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":227,"id":172},{"k":"text","x":388.0,"y":2573.59,"w":768.2,"h":15.0,"text":"Atiende las siguientes recomendaciones para implementar adecuadamente la ‘Barra de accesibilidad’:","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Atiende las siguientes recomendaciones para im