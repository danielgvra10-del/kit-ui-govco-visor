family":"Nunito Sans","weight":600,"style":"normal","ps":"NunitoSans-SemiBold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":0.0}],"seq":17,"id":103},{"k":"text","x":125.0,"y":221.17,"w":48.74,"h":20.0,"text":"Inicio","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Inicio","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":0.0}],"seq":19,"id":104},{"k":"text","x":126.0,"y":398.17,"w":154.04,"h":20.0,"text":"Buenas prácticas","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Buenas prácticas","font":{"family":"Nunito Sans","weight":600,"style":"normal","ps":"NunitoSans-SemiBold"},"size":20.0,"color":"#FFFFFF","opacity":1.0,"ls":0.0}],"seq":26,"id":105},{"k":"text","x":388.0,"y":3112.59,"w":1032.44,"h":15.0,"text":"Ten en cuenta las siguientes recomendaciones para mejorar la experiencia de los usuarios cuando utilicen el buscador de tu página web.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Ten en cuenta las siguientes recomendaciones para mejorar la experiencia de los usuarios cuando utilicen el buscador de tu página web.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":29,"id":106},{"k":"text","x":388.0,"y":3239.59,"w":1036.04,"h":37.0,"text":"La opción de autocompletar palabras guía al usuario en la construcción de sus consultas y le ayuda a encontrar de manera más eficaz la \ninformación que busca. Verifica que: ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"La opción de autocompletar palabras guía al usuario en la construcción de sus consultas y le ayuda a encontrar de manera más eficaz la información que busca. Verifica que: ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":30,"id":107},{"k":"text","x":388.0,"y":3305.59,"w":579.6,"h":15.0,"text":"- Las sugerencias son útiles (si están mal diseñadas, distraen y confunden). ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Las sugerencias son útiles (si están mal diseñadas, distraen y confunden). ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":33,"id":108},{"k":"text","x":388.0,"y":3349.59,"w":820.97,"h":15.0,"text":"- El autocompletado es inmediato,  así se reduce el esfuerzo de introducción de datos por parte del usuario. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- El autocompletado es inmediato,  así se reduce el esfuerzo de introducción de datos por parte del usuario. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":35,"id":109},{"k":"text","x":388.0,"y":3393.59,"w":683.55,"h":15.0,"text":"- Se resaltan las diferencias entre lo que escribe el usuario y las sugerencias del buscador.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- Se resaltan las diferencias entre lo que escribe el usuario y las sugerencias del buscador.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":37,"id":110},{"k":"text","x":388.0,"y":3520.59,"w":1116.45,"h":37.0,"text":"Almacena todas las iteraciones, incluidas las búsquedas recientes, para que puedas dar esta información al usuario la próxima vez que este realice \nuna consulta en tu sitio web.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Almacena todas las iteraciones, incluidas las búsquedas recientes, para que puedas dar esta información al usuario la próxima vez que este realice una consulta en tu sitio web.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":38,"id":111},{"k":"text","x":429.0,"y":3052.2,"w":187.75,"h":24.0,"text":"Buenas prácticas","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Buenas prácticas","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":40,"id":112},{"k":"text","x":388.0,"y":3183.17,"w":229.84,"h":20.0,"text":"Sugerencias automáticas","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Sugerencias automáticas","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":42,"id":113},{"k":"text","x":388.0,"y":3464.17,"w":201.32,"h":20.0,"text":"Historial de búsqueda","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Historial de búsqueda","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":43,"id":114},{"k":"text","x":388.0,"y":3704.59,"w":1112.92,"h":59.0,"text":"Procura cumplir los requerimientos y criterios de accesibilidad actuales. Así, las personas con discapacidad podrán percibir, comprender, navegar e \ninteractuar con éxito en tu sitio web. \nEspecíficamente, atiende estas recomendaciones para el componente “buscador”.","lh":22.0,"nlines":3,"rot":false,"runs":[{"text":"Procura cumplir los requerimientos y criterios de accesibilidad actuales. Así, las personas con discapacidad podrán percibir, comprender, navegar e interactuar con éxito en tu sitio web. Específicamente, atiende estas recomendaciones para el componente “buscador”.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":44,"id":115},{"k":"text","x":429.0,"y":3644.2,"w":146.23,"h":24.0,"text":"Accesibilidad","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Accesibilidad","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":47,"id":116},{"k":"text","x":388.0,"y":3857.59,"w":899.1,"h":37.0,"text":"Asegúrate de que texto del placeholder en el campo de búsqueda proporcione una indicación clara sobre su propósito. \nPor ejemplo: “Buscar aquí…”","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Asegúrate de que texto del placeholder en el campo de búsqueda proporcione una indicación clara sobre su propósito. Por ejemplo: “Buscar aquí…”","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":49,"id":117},{"k":"text","x":388.0,"y":3988.59,"w":1114.48,"h":37.0,"text":"Proporciona instrucciones breves y claras cerca del campo de búsqueda para orientar a los usuarios. Por ejemplo: “Escribe tu búsqueda y presiona \nEnter para buscar”.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Proporciona instrucciones breves y claras cerca del campo de búsqueda para orientar a los usuarios. Por ejemplo: “Escribe tu búsqueda y presiona Enter para buscar”.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":51,"id":118},{"k":"text","x":388.0,"y":4137.59,"w":1037.65,"h":15.0,"text":"Cuando los usuarios realicen una búsqueda, asegúrate de que los resultados sean claros y proporciona una manera de navegar por ellos.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Cuando los usuarios realicen una búsqueda, asegúrate de que los resultados sean claros y proporciona una manera de navegar por ellos.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":53,"id":119},{"k":"text","x":388.0,"y":4264.59,"w":1078.62,"h":37.0,"text":"Asegúrate de que los usuarios puedan navegar por el campo de búsqueda y el botón de búsqueda usando solo el teclado, y que se resalten al \nrecibir el enfoque.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Asegúrate de que los usuarios puedan navegar por el campo de búsqueda y el botón de búsqueda usando solo el teclado, y que se resalten al recibir el enfoque.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":54,"id":120},{"k":"text","x":388.0,"y":4413.59,"w":1038.53,"h":15.0,"text":"Proporciona un botón cerca del campo de búsqueda que permita a los usuarios borrar el contenido de campo de manera fácil y accesible.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Proporciona un botón cerca del campo de búsqueda que permita a los usuarios borrar el contenido de campo de manera fácil y accesible.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":56,"id":121},{"k":"text","x":388.0,"y":4540.59,"w":1072.68,"h":37.0,"text":"Asegúrate de que la interacción con el buscador siga patrones comunes y predecibles, de manera que los usuarios puedan comprender cómo \nutilizarlo sin dificultad.","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Asegúrate de que la interacción con el buscador siga patrones comunes y predecibles, de manera que los usuarios puedan comprender cómo utilizarlo sin dificultad.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":57,"id":122},{"k":"text","x":388.0,"y":3801.17,"w":195.84,"h":20.0,"text":"Mejora el placeholder","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Mejora el placeholder","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":59,"id":123},{"k":"text","x":388.0,"y":3932.17,"w":250.44,"h":20.0,"text":"Incluye instrucciones claras","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Incluye instrucciones claras","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":20.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":60,"id":124},{"k":"text","x":388.0,"y":4081.17,"w":278.44,"h":20.0,"text":"Proporciona retroalimen