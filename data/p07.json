mal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":3,"id":121},{"k":"text","x":388.0,"y":4164.59,"w":1110.56,"h":37.0,"text":"- El botón de cambio de idioma debe tener un nombre accesible corto y descriptivo en su etiqueta aria-label, por ejemplo: “Change language …” o \n“Cambiar idioma …”. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"- El botón de cambio de idioma debe tener un nombre accesible corto y descriptivo en su etiqueta aria-label, por ejemplo: “Change language …” o “Cambiar idioma …”. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":5,"id":122},{"k":"text","x":388.0,"y":4230.59,"w":1088.41,"h":15.0,"text":"- El cambio de idioma debe ser persistente en todas las páginas o secciones, y el idioma seleccionado debe mantenerse durante la navegación. ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"- El cambio de idioma debe ser persistente en todas las páginas o secciones, y el idioma seleccionado debe mantenerse durante la navegación. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":8,"id":123},{"k":"text","x":388.0,"y":4274.59,"w":1108.88,"h":37.0,"text":"Verifica que las personas con discapacidad puedan percibir, comprender, navegar e interactuar con éxito en tu sitio web. Además, procura cumplir \nlos requerimientos y criterios de accesibilidad actuales. ","lh":22.0,"nlines":2,"rot":false,"runs":[{"text":"Verifica que las personas con discapacidad puedan percibir, comprender, navegar e interactuar con éxito en tu sitio web. Además, procura cumplir los requerimientos y criterios de accesibilidad actuales. ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":10,"id":124},{"k":"text","x":388.0,"y":4038.59,"w":797.56,"h":15.0,"text":"Para garantizar contenidos accesibles te recomendamos tener en cuenta las siguientes recomendaciones:","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Para garantizar contenidos accesibles te recomendamos tener en cuenta las siguientes recomendaciones:","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":12,"id":125},{"k":"text","x":429.0,"y":3978.2,"w":146.23,"h":24.0,"text":"Accesibilidad","lh":null,"nlines":1,"rot":false,"runs":[{"text":"Accesibilidad","font":{"family":"Nunito Sans","weight":700,"style":"normal","ps":"NunitoSans-Bold"},"size":24.0,"color":"#000000","opacity":1.0,"ls":0.0}],"seq":13,"id":126},{"k":"text","x":388.0,"y":3788.59,"w":612.63,"h":15.0,"text":"1. Te recomendamos usar traducción simple en lugar de traducción automática.  ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"1. Te recomendamos usar traducción simple en lugar de traducción automática.  ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":15,"id":127},{"k":"text","x":388.0,"y":3832.59,"w":555.2,"h":15.0,"text":"2. El botón debe manejar una relación de 24 píxeles de ancho y de alto.  ","lh":null,"nlines":1,"rot":false,"runs":[{"text":"2. El botón debe manejar una relación de 24 píxeles de ancho y de alto.  ","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":17,"id":128},{"k":"text","x":388.0,"y":3876.59,"w":788.46,"h":15.0,"text":"3. En caso de utilizar el botón de traducción se deberá ubicar en la barra superior alineado a la derecha.","lh":null,"nlines":1,"rot":false,"runs":[{"text":"3. En caso de utilizar el botón de traducción se deberá ubicar en la barra superior alineado a la derecha.","font":{"family":"Verdana","weight":400,"style":"normal","ps":"Verdana"},"size":15.0,"color":"#4C4C4C","opacity":1.0,"ls":0.0}],"seq":19,"id":129},{"k":"text","x":388.0,"y":372